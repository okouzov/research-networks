# R&E·NET / NRN BG — settings for Apache / LiteSpeed hosting (Hostinger)

# always HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

DirectoryIndex index.html
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .svg

# no directory listings; keep helper files private
Options -Indexes
<FilesMatch "\.(py|md|ps1|zip)$">
  Require all denied
</FilesMatch>

# updates show up at once: pages, scripts, styles and data are revalidated on every visit
# (the server answers "304 not modified" when nothing changed, so this costs almost nothing)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(svg|ico|png|jpg|gif|webp|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
